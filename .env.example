# REQUIRED: Supabase Connect > Transaction pooler (port 6543).
# Use the database password, NOT an anon/publishable/service-role/secret API key.
# SUPABASE_* and NEXT_PUBLIC_SUPABASE_* variables are not used by this app.
# Server only; never PUBLIC_*.
DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@POOLER_HOST:6543/postgres?sslmode=require
# Session/direct connection for CLI migrations, if different from DATABASE_URL.
MIGRATION_DATABASE_URL=
# Optional Supabase server CA PEM for verified TLS (literal \n is accepted).
DATABASE_CA_CERT=
# Host-only secure cookies in production. false only for local HTTP.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
# The Blue Alliance Read API key. Server only.
TBA_API_KEY=
# Local development only: path to a Python interpreter with requirements.txt installed.
# Vercel runs api/ratings.py in its managed Python runtime automatically.
PYTHON_EXECUTABLE=
