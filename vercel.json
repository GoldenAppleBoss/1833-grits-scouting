{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.mjs": { "maxDuration": 60, "includeFiles": "scouting/public/**" },
    "api/ratings.py": { "maxDuration": 60, "excludeFiles": "{node_modules/**,.local/**,tests/**,scouting/**}" }
  },
  "rewrites": [
    { "source": "/scouting/api/ratings", "destination": "/api/ratings" },
    { "source": "/", "destination": "/api/index" },
    { "source": "/signup", "destination": "/api/index" },
    { "source": "/login", "destination": "/api/index" },
    { "source": "/logout", "destination": "/api/index" },
    { "source": "/settings", "destination": "/api/index" },
    { "source": "/admin", "destination": "/api/index" },
    { "source": "/admin/:path*", "destination": "/api/index" },
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/scouting", "destination": "/api/index" },
    { "source": "/scouting/", "destination": "/api/index" },
    { "source": "/scouting/:path*", "destination": "/api/index" }
  ]
}
